# WordPress API Configuration
# Set this to your WordPress Lightsail IP address since mywinnie.com now points to Vercel
# Example: WORDPRESS_API_URL=http://YOUR_LIGHTSAIL_IP/wp-json/wp/v2
WORDPRESS_API_URL=

# Resend API Key for contact form emails
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
